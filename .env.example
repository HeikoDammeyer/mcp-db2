# Db2 LUW connection — copy to .env and fill in. NEVER commit .env.
DB2_HOSTNAME=db2host.example.com
DB2_PORT=50000
DB2_DATABASE=SAMPLE
DB2_UID=readonly_user
DB2_PWD=

# TLS (optional). If SECURITY=SSL, PORT must be the SSL port, not the TCP/IP port.
#DB2_SECURITY=SSL
#DB2_SSLSERVERCERTIFICATE=/absolute/path/to/server-cert.arm

# Safety limits
DB2_MAX_ROWS=200
DB2_MAX_ROWS_LIMIT=5000
DB2_QUERY_TIMEOUT=30
DB2_POOL_SIZE=4
DB2_MAX_CELL_CHARS=4000

# Schema visibility (comma-separated, fnmatch-style patterns, case-insensitive).
# Allowlist empty = everything except denylist.
DB2_SCHEMA_ALLOWLIST=
DB2_SCHEMA_DENYLIST=SYS*,NULLID,SQLJ

# HTTP transport (only used with --transport http; stdio ignores all of this).
# Required: every request must send `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
DB2_HTTP_TOKEN=
# Bind address. 127.0.0.1 for local use, 0.0.0.0 in a container.
DB2_HTTP_BIND=127.0.0.1
# Accepted Host header values, comma-separated, ':*' matches any port. Empty disables the
# check — set it whenever you bind anything other than localhost.
DB2_HTTP_ALLOWED_HOSTS=
# Over HTTP several clients share this pool, and each query holds a connection while it runs.
# Raise DB2_POOL_SIZE above the default 4 accordingly.
